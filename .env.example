# Site
NEXT_PUBLIC_SITE_URL=

# WhatsApp enquiries (optional)
# Use the full international number without spaces or punctuation, e.g. 919876543210.
# When unset or invalid, the site shows contact/enquiry fallbacks instead of WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

