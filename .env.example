# Site
NEXT_PUBLIC_SITE_URL=

# WhatsApp enquiries (optional)
# Use the full international number without spaces or punctuation, e.g. 919876543210.
# When unset or invalid, the site shows contact/enquiry fallbacks instead of WhatsApp links.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (client infrastructure only — no queries or auth yet)
# Copy the project URL and publishable key from Supabase Dashboard -> Project Settings -> API.
# NEXT_PUBLIC_* values are exposed to the browser, so never put a secret or
# service-role key in one. The publishable key is not authorization; Row Level
# Security must protect data once queries are added.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin authentication (planned — not implemented in the foundation build)
ADMIN_SESSION_SECRET=
